# Kopirajte u .env i po potrebi izmenite. Fajl .env nikad ne ide u Git.
# Učitavanje u tekući terminal:  set -a; source .env; set +a

# Razvojna baza (make db)
DATABASE_URL=postgresql+psycopg://postgres:dev@localhost:5432/postgres

# Baza za integracione testove (make test-db)
TEST_DATABASE_URL=postgresql+psycopg://postgres:test@localhost:5433/postgres
